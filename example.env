# CSV
CSV_PATH_TEMPLATE_DIRECTORY=c:\ProgramData\Cleverence\DataBases\LSRV-DB-Shop15\XlsCsv\Templates\Upload\
CSV_PATH_TEMPLATE_FILE=import_data.csv
CSV_PATH_DIRECTORY=C:\SoftLand Systems\SLS-Shared\DCT\Upload\
CSV_FILE_PATTERN=^(MSK-TL-.*)\.csv$
CSV_FILE_NAME_FOR_FTP=import_data.csv
CSV_FILE_ENCODING=windows-1251
CSV_FILES_MIN_NUMBER=2
# example: CSV_SEPARATOR=; or CSV_SEPARATOR_IN=; and CSV_SEPARATOR_OUT=\t
CSV_SEPARATOR=;

# Datas
DATAS_COL_SKU=Номенклатурный номер
DATAS_COL_QUANTITY=Количество
DATAS_COL_WIDTH=Ширина
# DATAS_COL_COMPOUND=Состав
# DATAS_NAME_OF_PRODUCT_TYPE=Ткань текстильная
DATAS_MAX_WIDTH=220
DATAS_DECIMAL_PLACES=2

INACTIVITY_LIMIT_HOURS=24

# =====================================================================
# TELEGRAM NOTIFICATION CONFIGURATION
# =====================================================================
TELEGRAM_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id
PROXY=http://user:pass@ip:port
TELEGRAM_PARSE_MODE=Markdown

# =====================================================================
# SYSTEM FTP EXCHANGE CONFIGURATION
# =====================================================================
# FTP_ENABLED Values = ('1', 'true', 'yes', 'on') for True
FTP_ENABLED=True
FTP_HOST=ftp_hostname
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASS=ftp_password
FTP_PATH=/

# =====================================================================
# SYSTEM LOGGER ENVIRONMENT VARIABLES
# =====================================================================
# Log Format Width Settings
LOGFORMAT_ASCTIME=20
LOGFORMAT_LEVELNAME=8
LOGFORMAT_NAME=10
LOGFORMAT_FUNCNAME=27

# Logs
LOG_FILE=merge_log_%Y.%m.%d.log
LOG_DIR=logs\%Y\%Y.%m
LOG_LEVEL_ROOT=DEBUG
LOG_LEVEL_CONSOLE=DEBUG
LOG_LEVEL_FILE=WARNING
LOG_FORMAT_CONSOLE='%(filename)s:%(lineno)d\n%(log_color)s%(asctime)-${LOGFORMAT_ASCTIME}s| %(levelname)-${LOGFORMAT_LEVELNAME}s| %(name)-${LOGFORMAT_NAME}s| %(funcName)-${LOGFORMAT_FUNCNAME}s| %(message)s'
LOG_FORMAT_FILE='%(filename)s:%(lineno)d\t| %(asctime)-${LOGFORMAT_ASCTIME}s| %(levelname)-${LOGFORMAT_LEVELNAME}s| %(name)-${LOGFORMAT_NAME}s| %(funcName)-${LOGFORMAT_FUNCNAME}s| %(message)s'
LOG_DATE_FORMAT='%Y.%m.%d %H:%M:%S'
LOG_CONSOLE_LANGUAGE=en